/**
 * Analyse IA de production pour 02_Actions.
 * Cette fonction lit uniquement A1:Z300, ne touche jamais aux statuts,
 * et n'appelle ni Gmail ni Drive.
 */

var COMPTA_ADMIN_OPENAI_MODEL = 'gpt-4o-mini';
var COMPTA_ADMIN_IA_MAX_ACTIONS = 5;
var COMPTA_ADMIN_IA_MAX_SECONDS = 90;
var COMPTA_ADMIN_ALLOWED_DECISIONS = [
  'A_IGNORER',
  'A_TRAITER',
  'A_VERIFIER',
  'EN_ATTENTE'
];

/**
 * Analyse au maximum 5 actions ouvertes non encore analysées par IA.
 * Écrit obligatoirement :
 * W = Décision_IA_proposée
 * X = Commentaire_IA
 * Y = Règle_correction_proposée
 * Z = Analyse_IA
 */
function analyserActionsOuvertesRapideIA() {
  Logger.log('VERSION PROD WXYZ - 2026-05-10');
  Logger.log('Début analyse IA rapide');

  var start = Date.now();
  var maxRuntimeMs = COMPTA_ADMIN_IA_MAX_SECONDS * 1000;
  var maxRowsPerRun = COMPTA_ADMIN_IA_MAX_ACTIONS;

  var ss = getSpreadsheetForComptaAdminIA_();
  var sheet = ss.getSheetByName('02_Actions');

  if (!sheet) {
    throw new Error('Onglet 02_Actions introuvable.');
  }

  // Garantir les en-têtes IA en W:Z.
  sheet.getRange(1, 23, 1, 4).setValues([[
    'Décision_IA_proposée',
    'Commentaire_IA',
    'Règle_correction_proposée',
    'Analyse_IA'
  ]]);

  var lastRow = Math.min(sheet.getLastRow(), 300);

  if (lastRow < 2) {
    Logger.log('Aucune ligne à analyser.');
    return;
  }

  var values = sheet.getRange(1, 1, lastRow, 26).getValues();
  var headers = values[0];
  var headerMap = buildHeaderMap_(headers);

  var required = [
    'Domaine',
    'Action',
    'Priorité',
    'Statut_action',
    'Lien_Gmail',
    'Commentaire',
    'Dernière_maj'
  ];

  required.forEach(function(name) {
    if (headerMap[name] === undefined) {
      throw new Error('Colonne manquante dans 02_Actions : ' + name);
    }
  });

  var apiKey = getOpenAIKeyForComptaAdmin_();

  if (!apiKey) {
    throw new Error('OPENAI_API_KEY absente dans les propriétés du script.');
  }

  var opened = 0;
  var alreadyAnalysed = 0;
  var processed = 0;

  for (var r = 1; r < values.length; r++) {
    if (Date.now() - start > maxRuntimeMs) {
      Logger.log('Arrêt préventif avant timeout.');
      break;
    }

    if (processed >= maxRowsPerRun) {
      break;
    }

    var row = values[r];
    var rowNumber = r + 1;

    var statut = String(row[headerMap['Statut_action']] || '').trim();

    if (statut !== 'Ouvert') {
      continue;
    }

    opened++;

    // W = index 22 en tableau JS.
    // Important : on ignore uniquement si W est rempli.
    // Si Z est rempli mais W vide, on réanalyse pour compléter W:X:Y:Z.
    var decisionIA = String(row[22] || '').trim();

    if (decisionIA) {
      alreadyAnalysed++;
      continue;
    }

    Logger.log('Analyse IA ligne = ' + rowNumber);

    var lienGmail = row[headerMap['Lien_Gmail']] || '';

var payload = {
  domaine: row[headerMap['Domaine']] || '',
  action: row[headerMap['Action']] || '',
  priorite: row[headerMap['Priorité']] || '',
  statut_action: row[headerMap['Statut_action']] || '',
  lien_gmail: lienGmail,
  commentaire_utilisateur: row[headerMap['Commentaire']] || '',
  derniere_maj: row[headerMap['Dernière_maj']] || ''
};

var gmailInfo = enrichirPayloadAvecGmail_(payload, lienGmail);

payload.sujet_gmail = gmailInfo.sujet_gmail;
payload.expediteur_gmail = gmailInfo.expediteur_gmail;
payload.destinataire_gmail = gmailInfo.destinataire_gmail;
payload.extrait_gmail = gmailInfo.extrait_gmail;
payload.has_attachments = gmailInfo.has_attachments;
payload.noms_pieces_jointes = gmailInfo.noms_pieces_jointes;

    var result = analyseActionRowWithOpenAI_(payload, apiKey);
result = postTraiterResultatIAPourActions_(result, payload);

if (!result.ok) {
      sheet.getRange(rowNumber, 23, 1, 4).setValues([[
        'A_VERIFIER',
        'Erreur OpenAI HTTP ' + result.httpStatus,
        '',
        truncateForSheet_(result.error || 'Erreur pendant analyse IA', 1000)
      ]]);
// O = Créer_Task
// P = Task_ID
// Q = Créer_Calendar
// R = Calendar_Event_ID
// S = Commentaire

if (result.creation_task) {
  sheet.getRange(rowNumber, 15).setValue('Oui'); // O
}

if (result.creation_calendar) {
  sheet.getRange(rowNumber, 17).setValue('Oui'); // Q
}

// Ne jamais écrire dans P ou R ici.
// P et R sont réservés aux IDs réels de Google Tasks / Calendar.

var existingComment = String(sheet.getRange(rowNumber, 19).getValue() || '').trim();
var extraParts = [];

if (result.famille) {
  extraParts.push('Famille IA : ' + result.famille);
}

if (result.task_title) {
  extraParts.push('Task IA : ' + result.task_title);
}

if (result.creation_calendar) {
  extraParts.push(
    'Calendar IA : ' +
    [
      result.calendar_title,
      result.calendar_start_text,
      result.calendar_end_text,
      result.calendar_location
    ].filter(function(v) {
      return String(v || '').trim();
    }).join(' | ')
  );
}

if (extraParts.length > 0) {
  var newComment = existingComment
    ? existingComment + ' | ' + extraParts.join(' | ')
    : extraParts.join(' | ');

  sheet.getRange(rowNumber, 19).setValue(newComment); // S
}
      processed++;
      continue;
    }

    sheet.getRange(rowNumber, 23, 1, 4).setValues([[
      result.decision,
      result.commentaire,
      result.regle,
      result.analyse
    ]]);

    processed++;
  }

  Logger.log('Lignes ouvertes trouvées = ' + opened);
  Logger.log('Lignes déjà analysées = ' + alreadyAnalysed);
  Logger.log('Lignes analysées ce run = ' + processed);
  Logger.log('Fin analyse IA rapide');
}

/**
 * Appel OpenAI pour une ligne 02_Actions.
 */
function analyseActionRowWithOpenAI_(payload, apiKey) {
  var prompt = buildComptaAdminIaPrompt_(payload);

  var requestPayload = {
    model: COMPTA_ADMIN_OPENAI_MODEL,
    temperature: 0.1,
    max_tokens: 300,
    response_format: {
      type: 'json_object'
    },
    messages: [
      {
        role: 'system',
        content: 'Tu réponds uniquement en JSON valide. Tu aides à trier des actions comptables/admin.'
      },
      {
        role: 'user',
        content: prompt
      }
    ]
  };

  var response;

  try {
    response = UrlFetchApp.fetch('https://api.openai.com/v1/chat/completions', {
      method: 'post',
      contentType: 'application/json',
      headers: {
        Authorization: 'Bearer ' + apiKey
      },
      muteHttpExceptions: true,
      payload: JSON.stringify(requestPayload)
    });
  } catch (e) {
    return {
      ok: false,
      httpStatus: 'EXCEPTION',
      error: String(e)
    };
  }

  var status = response.getResponseCode();
  var text = response.getContentText();

  Logger.log('Statut HTTP OpenAI = ' + status);

  if (status < 200 || status >= 300) {
    return {
      ok: false,
      httpStatus: status,
      error: text
    };
  }

  var parsed;
  var content;
  var json;

  try {
    parsed = JSON.parse(text);
    content = parsed.choices &&
      parsed.choices[0] &&
      parsed.choices[0].message &&
      parsed.choices[0].message.content;

    json = JSON.parse(content || '{}');
  } catch (e) {
    return {
      ok: true,
      httpStatus: status,
      decision: 'A_VERIFIER',
      commentaire: 'Réponse IA illisible',
      regle: '',
      analyse: 'Erreur parsing JSON IA'
    };
  }

  var decision = normalizeIaDecision_(json.decision);

  return {
  ok: true,
  httpStatus: status,
  famille: truncateForSheet_(json.famille || '', 100),
  decision: decision,
  commentaire: truncateForSheet_(json.commentaire || '', 500),
  regle: truncateForSheet_(json.regle || '', 500),
  analyse: truncateForSheet_(json.analyse || '', 1000),
  creation_task: json.creation_task === true,
  task_title: truncateForSheet_(json.task_title || '', 300),
  creation_calendar: json.creation_calendar === true,
  calendar_title: truncateForSheet_(json.calendar_title || '', 300),
  calendar_start_text: truncateForSheet_(json.calendar_start_text || '', 300),
  calendar_end_text: truncateForSheet_(json.calendar_end_text || '', 300),
  calendar_location: truncateForSheet_(json.calendar_location || '', 300)
};
}

