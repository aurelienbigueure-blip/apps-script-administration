/**
 * Récupération robuste du fichier Google Sheet.
 */
function getSpreadsheetForComptaAdminIA_() {
  var id = '';

  if (typeof PROCESSING_CONFIG !== 'undefined' && PROCESSING_CONFIG.SPREADSHEET_ID) {
    id = PROCESSING_CONFIG.SPREADSHEET_ID;
  } else if (typeof Config !== 'undefined' && Config.SPREADSHEET_ID) {
    id = Config.SPREADSHEET_ID;
  }

  if (!id) {
    throw new Error('SPREADSHEET_ID absent dans PROCESSING_CONFIG ou Config.');
  }

  id = String(id).trim();

  // Si jamais une URL complète est fournie, on extrait l’ID.
  var match = id.match(/\/d\/([a-zA-Z0-9-_]+)/);

  if (match && match[1]) {
    id = match[1];
  }

  return SpreadsheetApp.openById(id);
}

/**
 * Récupération clé OpenAI.
 */
function getOpenAIKeyForComptaAdmin_() {
  return PropertiesService.getScriptProperties().getProperty('OPENAI_API_KEY') || '';
}

/**
 * Normalise la décision IA.
 */
function normalizeIaDecision_(decision) {
  var normalized = String(decision || '').trim().toUpperCase();

  if (COMPTA_ADMIN_ALLOWED_DECISIONS.indexOf(normalized) === -1) {
    return 'A_VERIFIER';
  }

  return normalized;
}

/**
 * Limite les textes trop longs avant écriture dans Sheet.
 */
function truncateForSheet_(value, maxLength) {
  var text = value === null || value === undefined ? '' : String(value);
  return text.length > maxLength ? text.slice(0, maxLength) : text;
}

/**
 * Construit une map nom de colonne => index JS.
 */
function buildHeaderMap_(headers) {
  var map = {};

  headers.forEach(function(header, index) {
    map[String(header).trim()] = index;
  });

  return map;
}
function enrichirPayloadAvecGmail_(payload, lienGmail) {
  var result = {
    sujet_gmail: '',
    expediteur_gmail: '',
    destinataire_gmail: '',
    extrait_gmail: '',
    has_attachments: false,
    noms_pieces_jointes: []
  };

  if (!lienGmail) {
    return result;
  }

  var messageId = extraireMessageIdDepuisLienGmail_(lienGmail);
  if (!messageId) {
    return result;
  }

  try {
    var message = GmailApp.getMessageById(messageId);

    if (!message) {
      return result;
    }

    result.sujet_gmail = truncateForSheet_(message.getSubject(), 300);
    result.expediteur_gmail = truncateForSheet_(message.getFrom(), 300);
    result.destinataire_gmail = truncateForSheet_(message.getTo(), 300);
    result.extrait_gmail = truncateForSheet_(message.getPlainBody(), 1500);

    var attachments = message.getAttachments() || [];
    result.has_attachments = attachments.length > 0;
    result.noms_pieces_jointes = attachments
      .slice(0, 5)
      .map(function(file) {
        return truncateForSheet_(file.getName(), 150);
      });

    return result;
  } catch (e) {
    result.extrait_gmail = 'Erreur lecture Gmail : ' + String(e && e.message ? e.message : e);
    return result;
  }
}

function extraireMessageIdDepuisLienGmail_(lienGmail) {
  var text = String(lienGmail || '').trim();

  if (!text) {
    return '';
  }

  var match = text.match(/#(?:all|inbox|sent|label\/[^/]+)\/([a-zA-Z0-9]+)/);

  if (match && match[1]) {
    return match[1];
  }

  var fallback = text.match(/([a-f0-9]{16,})/i);

  if (fallback && fallback[1]) {
    return fallback[1];
  }

  return '';
}
/**
 * Post-traitement déterministe des résultats IA.
 * Objectif : ne pas rater les événements évidents même si l'IA oublie creation_calendar.
 */
function postTraiterResultatIAPourActions_(result, payload) {
  var combined = [
    payload.domaine,
    payload.action,
    payload.commentaire_utilisateur,
    payload.sujet_gmail,
    payload.expediteur_gmail,
    payload.extrait_gmail,
    result.commentaire,
    result.analyse,
    result.regle
  ].join(' ').toLowerCase();

  var hasDateSignal =
    /\b(lundi|mardi|mercredi|jeudi|vendredi|samedi|dimanche)\b/i.test(combined) ||
    /\b\d{1,2}\s*(janvier|février|fevrier|mars|avril|mai|juin|juillet|août|aout|septembre|octobre|novembre|décembre|decembre)\b/i.test(combined) ||
    /\b\d{1,2}[\/.-]\d{1,2}([\/.-]\d{2,4})?\b/i.test(combined);

  var hasTimeSignal =
    /\b\d{1,2}\s*h\s*\d{0,2}\b/i.test(combined) ||
    /\b\d{1,2}:\d{2}\b/i.test(combined);

  var hasEventSignal =
    /rdv|rendez-vous|doctolib|doctissimo|consultation|médecin|medecin|kiné|kine|dentiste|ophtalmo|cabinet|zoom|visio|réunion|reunion|webinaire|conférence|conference/i.test(combined);

  var hasLocationSignal =
    /rue|avenue|boulevard|place|cabinet|zoom|visio|teams|meet|adresse/i.test(combined);

  if (hasDateSignal && hasTimeSignal && hasEventSignal) {
    result.creation_calendar = true;

    if (!result.calendar_title) {
      if (/doctolib|doctissimo|médecin|medecin|kiné|kine|dentiste|ophtalmo|santé|sante/i.test(combined)) {
        result.calendar_title = 'RDV médical';
      } else if (/zoom|visio|réunion|reunion|webinaire|conférence|conference/i.test(combined)) {
        result.calendar_title = 'Réunion / événement';
      } else {
        result.calendar_title = 'Événement à planifier';
      }
    }

    if (!result.calendar_start_text) {
      result.calendar_start_text = extraireDateHeureTexte_(combined);
    }

    if (!result.calendar_location && hasLocationSignal) {
      result.calendar_location = extraireLieuTexte_(combined);
    }

    if (result.decision === 'A_VERIFIER') {
      result.decision = 'A_TRAITER';
    }

    if (!result.commentaire || result.commentaire.indexOf('rendez-vous') === -1) {
      result.commentaire = result.commentaire
        ? result.commentaire + ' Événement daté détecté.'
        : 'Événement daté détecté à ajouter au calendrier.';
    }
  }

  // La colonne Y doit rester une règle de classification, pas un stockage d'événement.
  if (result.creation_calendar && result.regle && /date|heure|durée|duree|zoom|calendar|calendrier/i.test(result.regle)) {
    result.regle = '';
  }
  // Forcer une règle durable en colonne Y quand l’action est claire.
  // La colonne Y ne doit pas contenir une date, une heure ou une adresse.
  // Elle doit contenir une règle réutilisable pour Domaines_Suivi / Classification.
  if (result.creation_calendar && !result.regle) {
    if (/doctolib|doctissimo|rdv|rendez-vous|médecin|medecin|kiné|kine|dentiste|ophtalmo|santé|sante/i.test(combined)) {
      result.regle = 'KEEP_PERSONNEL_RDV_CALENDAR';
    } else if (/zoom|visio|réunion|reunion|webinaire|conférence|conference|teams|meet/i.test(combined)) {
      result.regle = 'KEEP_EVENT_WITH_DATE_TIME';
    } else {
      result.regle = 'KEEP_EVENT_WITH_DATE_TIME';
    }
  }

  if (result.creation_task && !result.regle) {
    if (result.famille === 'COMPTABLE') {
      result.regle = 'KEEP_COMPTABLE_ACTION';
    } else if (result.famille === 'ADMINISTRATIF') {
      result.regle = 'KEEP_ADMIN_ACTION';
    } else if (result.famille === 'PERSONNEL') {
      result.regle = 'KEEP_PERSONNEL_ACTION';
    } else {
      result.regle = 'KEEP_ACTION_TO_REVIEW';
    }
  }

  // Si la règle contient par erreur des détails de calendrier,
  // on la remplace par une règle propre.
  if (result.regle && /date\s*:|heure\s*:|durée\s*:|duree\s*:|lundi|mardi|mercredi|jeudi|vendredi|samedi|dimanche|\d{1,2}h|calendar ia/i.test(result.regle)) {
    if (result.creation_calendar) {
      result.regle = 'KEEP_EVENT_WITH_DATE_TIME';
    } else {
      result.regle = '';
    }
  }
  return result;
}

/**
 * Extraction simple d'une date/heure en texte.
 * Ne transforme pas en date JS : on garde une chaîne lisible pour validation humaine.
 */
function extraireDateHeureTexte_(text) {
  var patterns = [
    /(lundi|mardi|mercredi|jeudi|vendredi|samedi|dimanche)[^.,;\n]{0,80}(\d{1,2}\s*h\s*\d{0,2}|\d{1,2}:\d{2})/i,
    /(\d{1,2}\s*(janvier|février|fevrier|mars|avril|mai|juin|juillet|août|aout|septembre|octobre|novembre|décembre|decembre)[^.,;\n]{0,80}(\d{1,2}\s*h\s*\d{0,2}|\d{1,2}:\d{2}))/i,
