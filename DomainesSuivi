/**
 * Exploitation légère des propositions IA de 02_Actions pour alimenter 12_Domaines_Suivi.
 * Aucune suppression de règle existante et aucun appel à OpenAI, Gmail ou Drive.
 */

var COMPTA_ADMIN_DOMAINES_SUIVI_SHEET_NAME = '12_Domaines_Suivi';
var COMPTA_ADMIN_DOMAINES_HEADERS = [
  'Date_ajout',
  'Domaine_ou_motif',
  'Type',
  'Décision',
  'Règle_cible',
  'Statut_règle',
  'Priorité',
  'Source',
  'Commentaire',
  'Dernière_maj'
];

/**
 * Met à jour 12_Domaines_Suivi à partir des statuts et propositions IA de 02_Actions!A1:Z300.
 */
function majDomainesSuiviDepuisActions() {
  Logger.log('[Domaines Suivi] Début majDomainesSuiviDepuisActions');

  var ss = getSpreadsheet_();
  var actionSheet = ss.getSheetByName(COMPTA_ADMIN_ACTIONS_SHEET_NAME);
  if (!actionSheet) {
    Logger.log('[Domaines Suivi IA] Onglet 02_Actions introuvable, arrêt');
    return;
  }

  ensureSheetSizeForFastView_(actionSheet, COMPTA_ADMIN_FAST_MAX_ROWS, COMPTA_ADMIN_ACTIONS_MAX_COLS);
  var actionValues = actionSheet.getRange(1, 1, COMPTA_ADMIN_FAST_MAX_ROWS, COMPTA_ADMIN_ACTIONS_MAX_COLS).getValues();
  var actionHeaders = buildHeaderIndex_(actionValues[0]);
  Logger.log('[Domaines Suivi IA] Lecture limitée à 02_Actions!A1:Z300');

  var suiviSheet = getOrCreateDomainesSuiviSheet_(ss);
  var suiviHeaders = ensureDomainesSuiviHeaders_(suiviSheet);
  var existingKeys = buildExistingDomainesKeys_(suiviSheet, suiviHeaders);
  Logger.log('[Domaines Suivi IA] Clés existantes chargées : ' + Object.keys(existingKeys).length);

  var rowsToAppend = [];
  var now = new Date();

  for (var i = 1; i < actionValues.length; i++) {
    var actionRow = actionValues[i];
    var domaine = getByHeader_(actionRow, actionHeaders, 'Domaine');
    var statut = getByHeader_(actionRow, actionHeaders, 'Statut_action');
    var commentaire = getByHeader_(actionRow, actionHeaders, 'Commentaire');
    var decisionIa = getByHeader_(actionRow, actionHeaders, 'Décision_IA_proposée');
    var commentaireIa = getByHeader_(actionRow, actionHeaders, 'Commentaire_IA');
    var regleIa = getByHeader_(actionRow, actionHeaders, 'Règle_correction_proposée');
    var analyseIa = getByHeader_(actionRow, actionHeaders, 'Analyse_IA');
    var combinedText = [commentaire, decisionIa, commentaireIa, regleIa, analyseIa].join(' ');
    var normalizedStatut = normalizeTextForComptaAdmin_(statut);

    if ((normalizedStatut === normalizeTextForComptaAdmin_('À ignorer') || normalizeTextForComptaAdmin_(decisionIa) === 'a_ignorer') && hasValue_(domaine)) {
      addDomainesCandidate_(rowsToAppend, existingKeys, suiviHeaders, now, {
        domaineOuMotif: domaine,
        type: 'Domaine',
        decision: 'Exclure',
        regleCible: '',
        statutRegle: 'À ajouter Classification.gs',
        priorite: 'Moyenne',
        source: '02_Actions',
        commentaire: joinNonEmpty_([commentaire, commentaireIa, regleIa], ' | ')
      });
    }

    if ((normalizedStatut === normalizeTextForComptaAdmin_('Traité') || normalizeTextForComptaAdmin_(decisionIa) === 'a_traiter') && hasValue_(domaine)) {
      addDomainesCandidate_(rowsToAppend, existingKeys, suiviHeaders, now, {
        domaineOuMotif: domaine,
        type: 'Domaine',
        decision: 'Conserver / vérifier',
        regleCible: '',
        statutRegle: 'À ajouter Classification.gs',
        priorite: containsUsefulSignal_(combinedText) ? 'Haute' : 'Moyenne',
        source: '02_Actions',
        commentaire: joinNonEmpty_([commentaire, commentaireIa, regleIa, analyseIa], ' | ')
      });
    }
  }

  getSpecificDomainesSuiviRules_().forEach(function(rule) {
    addDomainesCandidate_(rowsToAppend, existingKeys, suiviHeaders, now, rule);
  });
  Logger.log('[Domaines Suivi IA] Candidats à ajouter : ' + rowsToAppend.length);

  if (rowsToAppend.length > 0) {
    suiviSheet.getRange(suiviSheet.getLastRow() + 1, 1, rowsToAppend.length, suiviHeaders.length).setValues(rowsToAppend);
    Logger.log('[Domaines Suivi IA] Lignes ajoutées : ' + rowsToAppend.length);
  } else {
    Logger.log('[Domaines Suivi IA] Aucune ligne nouvelle à ajouter');
  }

  Logger.log('[Domaines Suivi] Fin majDomainesSuiviDepuisActions');
}

