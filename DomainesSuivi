function getOrCreateDomainesSuiviSheet_(ss) {
  var sheet = ss.getSheetByName(COMPTA_ADMIN_DOMAINES_SUIVI_SHEET_NAME);
  if (!sheet) {
    sheet = ss.insertSheet(COMPTA_ADMIN_DOMAINES_SUIVI_SHEET_NAME);
    Logger.log('[Domaines Suivi IA] Onglet 12_Domaines_Suivi créé');
  }
  return sheet;
}

function ensureDomainesSuiviHeaders_(sheet) {
  ensureSheetSizeForFastView_(sheet, 2, COMPTA_ADMIN_DOMAINES_HEADERS.length);

  var lastColumn = Math.max(sheet.getLastColumn(), COMPTA_ADMIN_DOMAINES_HEADERS.length);
  var currentHeaders = sheet.getRange(1, 1, 1, lastColumn).getValues()[0];
  var normalized = buildHeaderIndex_(currentHeaders);

  if (sheet.getLastRow() === 0 || currentHeaders.join('').trim() === '') {
    sheet.getRange(1, 1, 1, COMPTA_ADMIN_DOMAINES_HEADERS.length).setValues([COMPTA_ADMIN_DOMAINES_HEADERS]);
    sheet.setFrozenRows(1);
    Logger.log('[Domaines Suivi IA] En-têtes minimum créés');
    return COMPTA_ADMIN_DOMAINES_HEADERS.slice();
  }

  var headers = currentHeaders.slice();
  COMPTA_ADMIN_DOMAINES_HEADERS.forEach(function(requiredHeader) {
    var key = normalizeHeaderForComptaAdmin_(requiredHeader);
    if (!normalized.hasOwnProperty(key)) {
      headers.push(requiredHeader);
      normalized[key] = headers.length - 1;
    }
  });

  if (headers.length > currentHeaders.length) {
    ensureSheetSizeForFastView_(sheet, 2, headers.length);
    sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
    Logger.log('[Domaines Suivi IA] Colonnes manquantes ajoutées aux en-têtes existants');
  }

  sheet.setFrozenRows(1);
  return headers;
}

function buildExistingDomainesKeys_(sheet, headers) {
  var keys = {};
  var lastRow = sheet.getLastRow();
  if (lastRow < 2) {
    return keys;
  }

  var data = sheet.getRange(2, 1, lastRow - 1, headers.length).getValues();
  var headerIndex = buildHeaderIndex_(headers);
  data.forEach(function(row) {
    var key = buildDomainesDedupeKey_(
      getByHeader_(row, headerIndex, 'Domaine_ou_motif'),
      getByHeader_(row, headerIndex, 'Décision'),
      getByHeader_(row, headerIndex, 'Règle_cible')
    );
    if (key !== '||') {
      keys[key] = true;
    }
  });
  return keys;
}

function addDomainesCandidate_(rowsToAppend, existingKeys, headers, now, candidate) {
  var key = buildDomainesDedupeKey_(candidate.domaineOuMotif, candidate.decision, candidate.regleCible);
  if (existingKeys[key]) {
    return;
  }

  existingKeys[key] = true;
  var row = new Array(headers.length).fill('');
  var headerIndex = buildHeaderIndex_(headers);

  setByHeader_(row, headerIndex, 'Date_ajout', now);
  setByHeader_(row, headerIndex, 'Domaine_ou_motif', candidate.domaineOuMotif || '');
  setByHeader_(row, headerIndex, 'Type', candidate.type || 'Motif');
  setByHeader_(row, headerIndex, 'Décision', candidate.decision || '');
  setByHeader_(row, headerIndex, 'Règle_cible', candidate.regleCible || '');
  setByHeader_(row, headerIndex, 'Statut_règle', candidate.statutRegle || 'À ajouter Classification.gs');
  setByHeader_(row, headerIndex, 'Priorité', candidate.priorite || 'Moyenne');
  setByHeader_(row, headerIndex, 'Source', candidate.source || '02_Actions');
  setByHeader_(row, headerIndex, 'Commentaire', candidate.commentaire || '');
  setByHeader_(row, headerIndex, 'Dernière_maj', now);

  rowsToAppend.push(row);
}

function setByHeader_(row, headerIndex, headerName, value) {
  var key = normalizeHeaderForComptaAdmin_(headerName);
  if (headerIndex.hasOwnProperty(key)) {
    row[headerIndex[key]] = value;
  }
}

function buildDomainesDedupeKey_(domaineOuMotif, decision, regleCible) {
  return [domaineOuMotif, decision, regleCible]
    .map(function(value) { return normalizeTextForComptaAdmin_(value); })
    .join('|');
}

function containsUsefulSignal_(text) {
  var normalized = normalizeTextForComptaAdmin_(text);
  var signals = [
    'facture',
    'devis',
    'compta',
    'comptable',
    'wecasa',
    'urssaf',
    'msa',
    'colissimo',
    'booking',
    'pulse',
    'google apps script',
    'projet ia',
    'rdv kine'
  ];

  return signals.some(function(signal) {
    return normalized.indexOf(normalizeTextForComptaAdmin_(signal)) !== -1;
  });
}

function extractUsefulSignalMotif_(text) {
  var normalized = normalizeTextForComptaAdmin_(text);
  var signals = ['facture', 'devis', 'compta', 'comptable', 'wecasa', 'urssaf', 'msa', 'colissimo', 'booking', 'pulse', 'google apps script', 'projet ia', 'rdv kine'];

  for (var i = 0; i < signals.length; i++) {
    if (normalized.indexOf(normalizeTextForComptaAdmin_(signals[i])) !== -1) {
      return signals[i];
    }
  }
  return 'Signal utile IA';
}

