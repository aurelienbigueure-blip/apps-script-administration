/**
 * Script V2 pour l'automatisation de la gestion des mails comptables et administratifs.
 *
 * Ce script complète le travail de configuration réalisé par `script_compta_admin.gs`.
 * Il lit les nouveaux mails dans Gmail (réception et envoi), applique des règles de
 * classification simples, renseigne le classeur de pilotage et, en mode actif,
 * extrait les pièces jointes dans l'arborescence Drive créée précédemment.
 *
 * Principales caractéristiques de cette V2 :
 *  - Lecture large : mails reçus et envoyés sur une période définie (voir paramètre LOOKBACK_DAYS).
 *  - Détection et exclusion des emails non pertinents (invitations, newsletters, Upmeet…).
 *  - Classification par entité (SAS, Perso_Locations, Perso_Vie, À vérifier), activité et catégorie.
 *  - Mise à jour du classeur Pilotage_Compta_Admin dans les onglets 01_Documents et 02_Actions.
 *  - Marquage des mails via des libellés Gmail pour éviter les doublons lors des exécutions suivantes.
 *  - Mode test : permet d’exécuter le script sans création de fichiers dans Drive.
 *
 * NOTE IMPORTANTE :
 *  Ce script propose un ensemble de règles de classement basées sur des mots‑clés et des
 *  expéditeurs courants. Les cas ambigus sont classés en « À vérifier » et font l’objet d’une
 *  action dans l’onglet 02_Actions. Les règles doivent être ajustées en fonction de vos flux réels.
 */

var PROCESSING_CONFIG = {
  /**
   * Période de recherche en jours pour les mails (test initial). Les mails plus anciens que
   * cette valeur ne seront pas analysés lors d’une exécution. Pour un run quotidien,
   * ce paramètre est remplacé par le calcul de la date de dernier passage.
   */
  LOOKBACK_DAYS: 365,

  /**
   * Nombre maximum de conversations Gmail à analyser à chaque exécution. Réduisez cette
   * valeur pour éviter les dépassements de quotas ou de temps d’exécution.
   */
  MAX_THREADS: 100,

  /**
   * Mode test : si true, les pièces jointes ne sont pas extraites dans Drive. Les mails
   * sont néanmoins analysés et les informations sont inscrites dans le classeur.
   */
  MODE_TEST: true,

  /**
   * Libellés Gmail utilisés pour suivre l’état des mails. Les mails déjà traités
   * (traités ou à vérifier) sont marqués pour éviter d’être re‑analysés.
   */
  LABEL_TREATED: 'Compta_Admin_Traité_V3',
  LABEL_TO_VERIFY: 'Compta_Admin_A_Verifier_V3',
  LABEL_EXCLUDED: 'Compta_Admin_Exclu_V3'
};

/**
 * Point d’entrée à déclencher pour lire et traiter les mails.
 * Ce traitement lit les nouveaux mails sur la période définie et met à jour
 * le classeur de pilotage. Aucune pièce jointe n’est extraite si MODE_TEST est true.
 */
function runComptaMailProcessing() {
  var params = getOrCreateParamSheet_();
  var lastRun = getLastRunDatetime_(params);
  var now = new Date();

  var query = buildGmailQuery_(lastRun);
  Logger.log("Requête Gmail utilisée : " + query);

  var threads = GmailApp.search(query, 0, PROCESSING_CONFIG.MAX_THREADS);

  var docSheet = getOrCreateDocSheet_();
  var actionSheet = getOrCreateActionSheet_();

  var treatedLabel = getOrCreateLabel_(PROCESSING_CONFIG.LABEL_TREATED);
  var verifyLabel = getOrCreateLabel_(PROCESSING_CONFIG.LABEL_TO_VERIFY);
  var excludedLabel = getOrCreateLabel_(PROCESSING_CONFIG.LABEL_EXCLUDED);

  var processedCount = 0;
  var documentRowsCount = 0;
  var actionRowsCount = 0;
  var excludedCount = 0;
  var errorCount = 0;

  threads.forEach(function(thread) {
    try {
      if (
        threadHasLabel_(thread, treatedLabel) ||
        threadHasLabel_(thread, verifyLabel) ||
        threadHasLabel_(thread, excludedLabel)
      ) {
        return;
      }

      processedCount++;

      var messages = thread.getMessages();
      var threadFinalStatus = "Traité";

      messages.forEach(function(message) {
        try {
          var result = processMessage_(message);

          if (!result) {
            Logger.log("Message ignoré : résultat vide");
            return;
          }

          if (result.status === "Exclu") {
            excludedCount++;
            threadFinalStatus = "Exclu";
            return;
          }

          if (result.documentRow && result.documentRow.length > 0) {
            appendDocumentRow_(docSheet, result.documentRow);
            documentRowsCount++;
          } else {
            Logger.log("Aucune ligne document à écrire pour le message : " + message.getId());
          }

          if (result.actionRow && result.actionRow.length > 0) {
            appendActionRow_(actionSheet, result.actionRow);
            actionRowsCount++;
          }

          if (result.status === "À vérifier") {
            threadFinalStatus = "À vérifier";
          }

        } catch (messageError) {
          errorCount++;
          Logger.log("Erreur message " + message.getId() + " : " + messageError);
        }
      });

      if (threadFinalStatus === "Exclu") {
        thread.addLabel(excludedLabel);
      } else if (threadFinalStatus === "À vérifier") {
        thread.addLabel(verifyLabel);
      } else {
        thread.addLabel(treatedLabel);
      }

    } catch (threadError) {
      errorCount++;
      Logger.log("Erreur thread : " + threadError);
    }
  });

  updateLastRunDatetime_(params, now);

  Logger.log("Traitement terminé");
  Logger.log("Conversations analysées : " + processedCount);
  Logger.log("Documents écrits : " + documentRowsCount);
  Logger.log("Actions écrites : " + actionRowsCount);
  Logger.log("Mails exclus : " + excludedCount);
  Logger.log("Erreurs : " + errorCount);
}

/**
 * Construit la requête Gmail pour rechercher les mails depuis la dernière exécution.
 * @param {Date|null} lastRunDate
 * @return {string} requête Gmail
 */
function buildGmailQuery_(lastRunDate) {
  var parts = [];
  // Exclure les mails déjà traités
  parts.push('-label:' + quoteGmailLabel_(PROCESSING_CONFIG.LABEL_TREATED));
  parts.push('-label:' + quoteGmailLabel_(PROCESSING_CONFIG.LABEL_TO_VERIFY));
  parts.push('-label:' + quoteGmailLabel_(PROCESSING_CONFIG.LABEL_EXCLUDED));

  // Période de recherche
  if (lastRunDate) {
    // Utiliser l’horodatage en format YYYY/MM/DD pour after:
    var formatted = Utilities.formatDate(lastRunDate, Session.getScriptTimeZone(), 'yyyy/MM/dd');
    parts.push('after:' + formatted);
  } else {
    // Si pas de dernière exécution, utiliser une période de recherche étendue
    parts.push('newer_than:' + PROCESSING_CONFIG.LOOKBACK_DAYS + 'd');
  }
  // Inclure reçus et envoyés
  // Pas de tag spécifique : on recherche tout le compte
  return parts.join(' ');
}

/**
 * Traite un message Gmail et renvoie un objet contenant les informations
 * nécessaires pour alimenter le classeur. Retourne null si le mail doit être exclu.
 *
 * @param {GmailMessage} message
 * @return {Object|null}
 */
function processMessage_(message) {
  var now = new Date();

  var from = message.getFrom() || "";
  var to = message.getTo() || "";
  var cc = message.getCc() || "";
  var bcc = message.getBcc() || "";
  var recipients = [to, cc, bcc].filter(Boolean).join("\n");

  var subject = message.getSubject() || "";
  var dateMail = message.getDate();
  var body = message.getPlainBody() || "";
  var bodyPreview = body.substring(0, 1200);

  var attachments = message.getAttachments({
    includeInlineImages: false,
    includeAttachments: true
  });

  var relevantAttachments = getRelevantAttachments_(attachments);
  var attachmentSummary = getAttachmentSummary_(relevantAttachments);

  var direction = detectMailDirection_(from, recipients);

  var classification = classifyEmail_(
    from,
    recipients,
    subject,
    bodyPreview,
    attachmentSummary.names
  );

  if (!classification) {
    return null;
  }

  if (classification.status === "Exclu") {
    return {
      status: "Exclu",
      documentRow: null,
      actionRow: null
    };
  }

  /*
   * Cas important :
   * Si aucun document utile, aucun mot-clé comptable/admin, et aucune règle forte,
   * on exclut pour éviter de polluer le Sheet.
   */
  if (
    relevantAttachments.length === 0 &&
    classification.rule === "DEFAULT_NON_UTILE"
  ) {
    return {
      status: "Exclu",
      documentRow: null,
      actionRow: null
    };
  }

  /*
   * Si une pièce jointe utile existe mais que le classement n'est pas sûr,
   * on garde en À vérifier.
   */
  if (
    relevantAttachments.length > 0 &&
    classification.rule === "DEFAULT_A_VERIFIER"
  ) {
    classification.status = "À vérifier";
    classification.action = "Examiner cet e-mail et ses pièces jointes pour déterminer le classement.";
  }

  /*
   * En mode test, on ne sauvegarde pas dans Drive.
   * En mode réel, on extrait seulement les pièces jointes utiles et non exclues.
   */
  var driveLinks = "";
  if (
    !PROCESSING_CONFIG.MODE_TEST &&
    classification.status !== "Exclu" &&
    relevantAttachments.length > 0 &&
    classification.dossier
  ) {
    driveLinks = saveAttachmentsToDrive_(
      relevantAttachments,
      dateMail,
      from,
      subject,
      classification.dossier
    ) || "";
  }

  var documentRow = buildDocumentRow_({
    message: message,
    now: now,
    dateMail: dateMail,
    direction: direction,
    from: from,
    recipients: recipients,
    subject: subject,
    bodyPreview: bodyPreview,
    attachments: relevantAttachments,
    attachmentSummary: attachmentSummary,
    classification: classification,
    driveLinks: driveLinks
  });

  var actionRow = null;

  if (
    classification.status === "À vérifier" ||
    classification.createAction === true ||
    classification.action
  ) {
    actionRow = buildActionRow_({
      message: message,
      now: now,
      documentId: message.getId(),
      classification: classification,
      driveLinks: driveLinks
    });
  }

  return {
    status: classification.status,
    documentRow: documentRow,
    actionRow: actionRow
  };
}

/**
 * Détermine la classification d’un e‑mail à partir de son expéditeur, de son objet
 * et d’un aperçu de son corps. Les règles sont simplistes et peuvent être améliorées.
 * @param {string} from
 * @param {string} to
 * @param {string} subject
 * @param {string} bodyPreview
 * @return {Object} classification
 */
function classifyEmail_(from, recipients, subject, bodyPreview, attachmentNames) {
  var lowFrom = normalizeText_(from);
  var lowRecipients = normalizeText_(recipients);
  var lowSubject = normalizeText_(subject);
  var lowBody = normalizeText_(bodyPreview);
  var lowAttachments = normalizeText_(attachmentNames || "");

  var all = [
    lowFrom,
    lowRecipients,
    lowSubject,
    lowBody,
    lowAttachments
  ].join(" ");

  var classification = {
    entity: "",
    activity: "",
    category: "",
    dossier: "",
    dossierExistantProbable: "",
    status: "À vérifier",
    confiance: "Faible",
    rule: "DEFAULT_A_VERIFIER",
    decisionIA: "",
    action: "Examiner cet e-mail manuellement pour déterminer son classement.",
    createAction: true,
    priority: "Moyenne",
    typeAction: "Vérifier classement",
    dejaTransmisComptable: "Non",
    doublonProbable: "Non",
    comment: ""
  };

  /*
   * 1. Exclusions évidentes.
   * Objectif : ne pas polluer 01_Documents et 02_Actions avec les newsletters,
   * alertes commerciales, réseaux sociaux, notifications techniques sans enjeu comptable.
   */
  if (isClearlyExcluded_(lowFrom, lowRecipients, lowSubject, lowBody, lowAttachments)) {
    classification.status = "Exclu";
    classification.confiance = "Forte";
    classification.rule = "EXCLUSION_BRUIT";
    classification.action = "";
    classification.createAction = false;
    return classification;
  }

  /*
   * 2. CERFRANCE / comptables.
   * Important : on regarde expéditeur ET destinataires,
   * car certains mails importants sont envoyés par toi vers Valentine ou Sylvain.
   */
  if (
    containsAny_(all, [
      "cerfrance",
      "alliancecomtoise",
      "alliance comtoise",
      "vbardoux",
      "valentine bardoux",
      "sligey",
      "sylvain ligey"
    ])
  ) {
    classification.entity = "SAS";
    classification.activity = "Comptable";
    classification.category = "Échanges comptables";
    classification.dossier = buildSasDossierPath_("06_Bilan_Comptable");
    classification.status = "À vérifier";
    classification.confiance = "Forte";
    classification.rule = "CERFRANCE_COMPTABLE";
    classification.typeAction = "Vérifier classement";
    classification.action = "Vérifier le mail Cerfrance et classer les pièces jointes ou demandes associées.";
    classification.createAction = true;

    if (isSentToComptable_(lowRecipients)) {
      classification.dejaTransmisComptable = "Oui";
      classification.action = "Vérifier que les pièces transmises au comptable sont bien complètes.";
    }

    if (
      containsAny_(all, ["tva", "taxe sur la valeur ajoutee", "1er trimestre", "trimestre 2026"])
    ) {
      classification.activity = "Fiscalité";
      classification.category = "TVA";
      classification.dossier = buildSasDossierPath_("03_TVA_Impots");
      classification.rule = "CERFRANCE_TVA";
      classification.action = "Vérifier la demande TVA Cerfrance et rattacher les justificatifs nécessaires.";
    }

    if (
      containsAny_(all, ["releve", "relevé", "56532309650", "sas bigueure brothers", "compte courant"])
    ) {
      classification.activity = "Banque";
      classification.category = "Relevé bancaire SAS";
      classification.dossier = buildSasDossierPath_("04_Banque_Paiements");
      classification.rule = "CERFRANCE_RELEVE_BANCAIRE_SAS";
      classification.action = "Vérifier les relevés bancaires SAS transmis au comptable.";
    }

    return classification;
  }

  /*
   * 3. Solaire / SAS.
   */
  if (
    containsAny_(all, [
      "enedis-noreply",
      "enedis",
      "contrat production",
      "facture enedis",
      "publication semestrielle",
      "donnees de comptage",
      "données de comptage",
      "afc-agence prod",
      "afc gestion petitprod",
      "edf obligation d achat",
      "obligation d achat",
      "oa-solaire",
      "oa solaire",
      "isolarcloud",
      "bfc solaire"
    ])
  ) {
    classification.entity = "SAS";
    classification.activity = "Solaire";
    classification.category = "Document solaire";
    classification.dossier = buildSasDossierPath_("01_Solaire");
    classification.status = "À extraire";
    classification.confiance = "Forte";
    classification.rule = "SOLAIRE_GLOBAL";
    classification.action = "";
    classification.createAction = false;

    if (containsAny_(all, ["facture", "votre facture", "facture enedis"])) {
      classification.category = "Facture";
      classification.dossier = buildSasDossierPath_("01_Solaire/Enedis_Factures");
      classification.rule = "ENEDIS_FACTURE";
    }

    if (
      containsAny_(all, [
        "publication semestrielle",
        "donnees de comptage",
        "données de comptage",
        "comptage"
      ])
    ) {
      classification.category = "Données de comptage";
      classification.dossier = buildSasDossierPath_("01_Solaire/Enedis_Comptage");
      classification.rule = "ENEDIS_COMPTAGE";
    }

    if (containsAny_(all, ["paiement de votre facture", "obligation d achat", "oa-solaire"])) {
      classification.category = "OA / Paiement";
      classification.dossier = buildSasDossierPath_("01_Solaire/EDF_OA");
      classification.rule = "OA_SOLAIRE";
    }

    if (containsAny_(all, ["isolarcloud"])) {
      classification.category = "iSolarCloud";
      classification.dossier = buildSasDossierPath_("01_Solaire/iSolarCloud");
      classification.rule = "ISOLARCLOUD";
    }

    return classification;
  }

  /*
 * 4. Airbnb / locations personnelles.
 */
if (
  containsAny_(all, [
    "airbnb",
    "versement",
    "reservation airbnb",
    "réservation airbnb",
    "logement",
    "identifiant de versement",
    "revenus"
  ])
) {
  classification.entity = "Perso_Locations";
  classification.activity = "Airbnb";
  classification.category = "Réservation / Versement";
  classification.status = "À vérifier";
  classification.confiance = "Moyenne";
  classification.rule = "AIRBNB_GLOBAL";
  classification.typeAction = "Vérifier classement";
  classification.action = "Confirmer si le mail Airbnb concerne Aubervilliers ou Annoire.";
  classification.createAction = true;

  /*
   * Règle spécifique :
   * Pépé grange rénovée = Airbnb Annoire.
   */
  if (
    containsAny_(all, [
      "pepe grange renovee",
      "pépé grange rénovée",
      "grange renovee",
      "grange rénovée",
      "annoire"
    ])
  ) {
    classification.activity = "Airbnb_Annoire";
    classification.dossier = buildPersoLocationDossierPath_("02_Airbnb_Annoire/Airbnb_Réservations");
    classification.status = "Détecté";
    classification.confiance = "Forte";
    classification.rule = "AIRBNB_ANNOIRE";
    classification.action = "";
    classification.createAction = false;
    return classification;
  }

  /*
   * Règle spécifique :
   * Aubervilliers si l'adresse ou la ville apparaît.
   */
  if (
    containsAny_(all, [
      "aubervilliers",
      "52 rue auvry",
      "rue auvry",
      "93300"
    ])
  ) {
    classification.activity = "Airbnb_Aubervilliers";
    classification.dossier = buildPersoLocationDossierPath_("01_Airbnb_Aubervilliers/Airbnb_Réservations");
    classification.status = "Détecté";
    classification.confiance = "Forte";
    classification.rule = "AIRBNB_AUBERVILLIERS";
    classification.action = "";
    classification.createAction = false;
    return classification;
  }

  /*
   * Si le logement n'est pas identifié, on garde une action de vérification.
   */
  classification.dossier = buildPersoLocationDossierPath_("99_A_Verifier");
  return classification;
}

  /*
   * 5. Wecasa = frais de ménage Airbnb Aubervilliers.
   */
  if (containsAny_(all, ["wecasa", "session menage", "session ménage", "aide menagere", "aide ménagère"])) {
    classification.entity = "Perso_Locations";
    classification.activity = "Airbnb_Aubervilliers";
    classification.category = "Frais ménage";
    classification.dossier = buildPersoLocationDossierPath_("01_Airbnb_Aubervilliers/Frais_Ménage_Wecasa");
    classification.status = "À extraire";
    classification.confiance = "Forte";
    classification.rule = "WECASA_AUBERVILLIERS";
    classification.action = "";
    classification.createAction = false;
    return classification;
  }

  /*
   * 6. Banque / assurance.
   * On garde en À vérifier car il faut distinguer perso / SAS.
   */
  if (
    containsAny_(all, [
      "credit agricole",
      "crédit agricole",
      "ca-franchecomte",
      "banque postale",
      "labanquepostale",
      "revolut",
      "virement",
      "prelevement",
      "prélèvement",
      "vos documents banque assurance",
      "message de notification",
      "releve bancaire",
      "relevé bancaire"
    ])
  ) {
    classification.entity = "À vérifier";
    classification.activity = "Banque";
    classification.category = "Notification bancaire";
    classification.dossier = "99_A_VERIFIER_GLOBAL";
    classification.status = "À vérifier";
    classification.confiance = "Moyenne";
    classification.rule = "BANQUE_A_VERIFIER";
    classification.typeAction = "Vérifier classement";
    classification.action = "Vérifier si ce mail bancaire concerne la SAS, le perso ou les locations.";
    classification.createAction = true;
    return classification;
  }

  /*
   * 7. Santé / pharmacie / administratif perso.
   */
  if (
    containsAny_(all, [
      "pharmacie",
      "pharmaciedusports",
      "centre racine",
      "espace patient",
      "msa",
      "remboursements maladie",
      "mutuelle",
      "securite sociale",
      "sécurité sociale"
    ])
  ) {
    classification.entity = "Perso_Vie";
    classification.activity = "Santé";
    classification.category = "Santé / remboursement / justificatif";
    classification.dossier = buildPersoVieDossierPath_("03_Sante");
    classification.status = "À vérifier";
    classification.confiance = "Moyenne";
    classification.rule = "SANTE_PERSO";
    classification.typeAction = "Vérifier classement";
    classification.action = "Vérifier si ce mail santé doit être conservé comme justificatif personnel.";
    classification.createAction = true;
    return classification;
  }

  /*
   * 8. Factures / commandes / fournisseurs.
   * Prudence : Amazon, Leroy, Prolians peuvent être perso ou pro.
   */
  if (
    containsAny_(all, [
      "facture",
      "commande",
      "expedie",
      "expédié",
      "livre",
      "livré",
      "paiement",
      "recu",
      "reçu",
      "justificatif",
      "amazon",
      "prolians",
      "boulanger",
      "leroy merlin",
      "totalenergies",
      "edf",
      "sncf",
      "transavia",
      "eurostar"
    ])
  ) {
    classification.entity = "À vérifier";
    classification.activity = "Achat / justificatif";
    classification.category = "Facture ou justificatif potentiel";
    classification.dossier = "99_A_VERIFIER_GLOBAL";
    classification.status = "À vérifier";
    classification.confiance = "Faible";
    classification.rule = "FACTURE_JUSTIFICATIF_A_VERIFIER";
    classification.typeAction = "Vérifier classement";
    classification.action = "Vérifier si ce mail contient un justificatif utile pour SAS, perso ou locations.";
    classification.createAction = true;
    return classification;
  }

  /*
   * 9. COMET / Groupama hors compta perso.
   * À exclure du flux compta/admin perso.
   */
  if (
    containsAny_(all, [
      "comet",
      "upmeet",
      "gma",
      "groupama",
      "habilitations comet",
      "habilitation comet",
      "synchro gma",
      "go/no go",
      "documentation dpom",
      "demande d acces",
      "demande d'accès",
      "cooperactions",
      "sharepoint"
    ])
  ) {
    classification.status = "Exclu";
    classification.confiance = "Forte";
    classification.rule = "EXCLUSION_COMET_GROUPAMA";
    classification.action = "";
    classification.createAction = false;
    return classification;
  }

  /*
   * 10. Cas par défaut.
   * Si aucune règle utile ne s'applique : on exclut, pour ne pas transformer toute la boîte mail en actions.
   */
  classification.status = "Exclu";
  classification.confiance = "Moyenne";
  classification.rule = "DEFAULT_NON_UTILE";
  classification.action = "";
  classification.createAction = false;

  return classification;
}

/**
 * Construit un chemin de dossier pour les entités SAS dans l’arborescence Drive.
 * Ajoute automatiquement l’année en cours.
 * @param {string} subPath sous-dossier spécifique (ex. '01_Solaire/Enedis_Factures')
 * @return {string}
 */
function buildSasDossierPath_(subPath) {
  var year = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy');
  return '01_SAS_BIGUEURE_BROTHERS/' + year + '/' + subPath;
}

/**
 * Construit un chemin de dossier pour les locations personnelles.
 * Ajoute automatiquement l’année en cours.
 * @param {string} subPath sous-dossier spécifique
 * @return {string}
 */
function buildPersoLocationDossierPath_(subPath) {
  var year = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy');
  return '02_PERSO_LOCATIONS/' + year + '/' + subPath;
}

/**
 * Construit un chemin de dossier pour les documents de la vie personnelle.
 * Ajoute automatiquement l’année en cours.
 * @param {string} subPath sous-dossier spécifique
 * @return {string}
 */
function buildPersoVieDossierPath_(subPath) {
