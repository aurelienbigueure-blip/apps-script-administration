/**
 * Teste si un thread possède un libellé donné.
 */
function threadHasLabel_(thread, label) {
  var labels = thread.getLabels();
  for (var i = 0; i < labels.length; i++) {
    if (labels[i].getName() === label.getName()) {
      return true;
    }
  }
  return false;
}

