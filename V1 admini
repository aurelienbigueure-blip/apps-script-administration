function getRelevantAttachments_(attachments) {
  var relevant = [];

  if (!attachments || attachments.length === 0) {
    return relevant;
  }

  var allowedExtensions = [
    "pdf",
    "doc",
    "docx",
    "xls",
    "xlsx",
    "csv",
    "jpg",
    "jpeg",
    "png"
  ];

  var excludedExtensions = [
    "ics"
  ];

  attachments.forEach(function(att) {
    var name = att.getName() || "";
    var ext = getExtension_(name);

    if (excludedExtensions.indexOf(ext) !== -1) {
      return;
    }

    if (allowedExtensions.indexOf(ext) === -1) {
      return;
    }

    /*
     * Exclure les petites images automatiques de signature / tracking.
     */
    if (
      ["jpg", "jpeg", "png"].indexOf(ext) !== -1 &&
      att.getSize() < 15000
    ) {
      return;
    }

    relevant.push(att);
  });

  return relevant;
}
