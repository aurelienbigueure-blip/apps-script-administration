/**
 * Interface et mise en forme rapides pour le classeur Pilotage_Compta_Admin.
 * Ces fonctions ne modifient pas les données métier et ne lancent aucun appel OpenAI/Gmail/Drive.
 */

var COMPTA_ADMIN_ACTIONS_SHEET_NAME = '02_Actions';
var COMPTA_ADMIN_TRIAGE_IA_SHEET_NAME = '14_Triage_IA';
var COMPTA_ADMIN_FAST_MAX_ROWS = 300;
var COMPTA_ADMIN_ACTIONS_MAX_COLS = 26;


/**
 * Mise en forme rapide de production, appelée depuis le menu.
 */
function setupMiseEnFormeRapideComptaAdmin() {
  Logger.log('[Mise en forme rapide] Début');
  setupPerformanceComptaAdmin();
  Logger.log('[Mise en forme rapide] Fin');
}

/**
 * Rend 02_Actions plus léger à utiliser en limitant les filtres, formats et colonnes visibles.
 */
function setupPerformanceComptaAdmin() {
  Logger.log('Début setup performance Compta Admin');

  const ss = SpreadsheetApp.openById(PROCESSING_CONFIG.SPREADSHEET_ID);
  const actionsSheet = ss.getSheetByName('02_Actions');
  const domainesSheet = ss.getSheetByName('12_Domaines_Suivi');
  const triageSheet = ss.getSheetByName('14_Triage_IA');

  if (!actionsSheet) {
    throw new Error('Onglet 02_Actions introuvable.');
  }

  if (triageSheet) {
    triageSheet.hideSheet();
    Logger.log('Onglet 14_Triage_IA masqué.');
  }

  actionsSheet.setFrozenRows(1);
  appliquerColonnesVisiblesActions_(actionsSheet);
  recreerFiltreActions_(actionsSheet);

  const lastRowActions = Math.min(Math.max(actionsSheet.getLastRow(), 1), 300);

  actionsSheet.getRange(1, 1, 1, 26)
    .setFontWeight('bold')
    .setBackground('#D9EAF7');

  if (lastRowActions > 1) {
    actionsSheet.getRange(2, 8, lastRowActions - 1, 1).setWrap(true);
    actionsSheet.getRange(2, 19, lastRowActions - 1, 1).setWrap(true);
    actionsSheet.getRange(2, 24, lastRowActions - 1, 3).setWrap(true);
  }

  if (domainesSheet) {
    const lastRowDomaines = Math.min(Math.max(domainesSheet.getLastRow(), 1), 300);
    const lastColDomaines = Math.min(Math.max(domainesSheet.getLastColumn(), 1), 10);

    domainesSheet.setFrozenRows(1);
    domainesSheet.getRange(1, 1, 1, lastColDomaines)
      .setFontWeight('bold')
      .setBackground('#D9EAF7');

    const existingFilter = domainesSheet.getFilter();
    if (existingFilter) {
      existingFilter.remove();
    }

    domainesSheet.getRange(1, 1, lastRowDomaines, lastColDomaines).createFilter();
  }

  Logger.log('Fin setup performance Compta Admin');
}

