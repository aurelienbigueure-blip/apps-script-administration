/**
 * Audite les colonnes utiles de 02_Actions et 12_Domaines_Suivi sans modifier les données.
 */
function auditColonnesComptaAdmin() {
  Logger.log('[Audit colonnes] Début');

  var ss = getSpreadsheet_();
  auditSheetHeaders_(ss, COMPTA_ADMIN_ACTIONS_SHEET_NAME, [
    'Domaine',
    'Action',
    'Priorité',
    'Statut_action',
    'Lien_Gmail',
    'Commentaire',
    'Dernière_maj',
    'Décision_IA_proposée',
    'Commentaire_IA',
    'Règle_correction_proposée',
    'Analyse_IA'
  ], COMPTA_ADMIN_ACTIONS_MAX_COLS);

  auditSheetHeaders_(ss, '12_Domaines_Suivi', [
    'Date_ajout',
    'Domaine_ou_motif',
    'Type',
    'Décision',
    'Règle_cible',
    'Statut_règle',
    'Priorité',
    'Source',
    'Commentaire',
    'Dernière_maj'
  ], 20);

  Logger.log('[Audit colonnes] Fin');
}

function auditSheetHeaders_(ss, sheetName, requiredHeaders, maxColumnsToRead) {
  var sheet = ss.getSheetByName(sheetName);
  if (!sheet) {
    Logger.log('[Audit colonnes] Onglet absent : ' + sheetName);
    return;
  }

  var columns = Math.max(maxColumnsToRead, requiredHeaders.length);
  ensureSheetSizeForFastView_(sheet, 1, columns);
  var headerRow = sheet.getRange(1, 1, 1, columns).getValues()[0];
  var headerIndex = buildHeaderIndex_(headerRow);
  var missing = [];

  requiredHeaders.forEach(function(header) {
    if (!headerIndex.hasOwnProperty(normalizeHeaderForComptaAdmin_(header))) {
      missing.push(header);
    }
  });

  if (missing.length === 0) {
    Logger.log('[Audit colonnes] ' + sheetName + ' : OK');
  } else {
    Logger.log('[Audit colonnes] ' + sheetName + ' : colonnes manquantes = ' + missing.join(', '));
  }
}

function recreateActionsFastFilter_(sheet) {
  removeExistingFilter_(sheet);
  sheet.getRange(1, 1, COMPTA_ADMIN_FAST_MAX_ROWS, COMPTA_ADMIN_ACTIONS_MAX_COLS).createFilter();
}

function hideAllThenShowUsefulActionColumns_(sheet) {
  sheet.showColumns(1, COMPTA_ADMIN_ACTIONS_MAX_COLS);
  sheet.hideColumns(1, COMPTA_ADMIN_ACTIONS_MAX_COLS);

  var visibleColumns = [5, 8, 9, 12, 13, 19, 20, 23, 24, 25, 26];
  visibleColumns.forEach(function(column) {
    sheet.showColumns(column);
  });
}

function applyLightActionsFormatting_(sheet) {
  var headerRange = sheet.getRange(1, 1, 1, COMPTA_ADMIN_ACTIONS_MAX_COLS);
  headerRange.setFontWeight('bold').setBackground('#f1f3f4');

  sheet.getRange(1, 1, COMPTA_ADMIN_FAST_MAX_ROWS, COMPTA_ADMIN_ACTIONS_MAX_COLS)
    .setVerticalAlignment('top');

  [8, 19, 23, 24, 25, 26].forEach(function(column) {
    sheet.getRange(1, column, COMPTA_ADMIN_FAST_MAX_ROWS, 1).setWrap(true);
  });

  sheet.setRowHeights(1, COMPTA_ADMIN_FAST_MAX_ROWS, 24);
  sheet.setColumnWidth(5, 140);
  sheet.setColumnWidth(8, 300);
  sheet.setColumnWidth(9, 90);
  sheet.setColumnWidth(12, 115);
  sheet.setColumnWidth(13, 170);
  sheet.setColumnWidth(19, 280);
  sheet.setColumnWidth(20, 145);
  sheet.setColumnWidth(23, 155);
  sheet.setColumnWidth(24, 280);
  sheet.setColumnWidth(25, 260);
  sheet.setColumnWidth(26, 320);
}

function hideTriageIaSheetIfExists_(ss) {
  var triageSheet = ss.getSheetByName(COMPTA_ADMIN_TRIAGE_IA_SHEET_NAME);
  if (triageSheet && ss.getSheets().length > 1) {
    triageSheet.hideSheet();
  }
}

function ensureActionIaHeaders_(sheet) {
  var headers = sheet.getRange(1, 1, 1, COMPTA_ADMIN_ACTIONS_MAX_COLS).getValues()[0];
  var expectedHeaders = {
    21: 'Explication_action',
    22: 'Pourquoi_remonté',
    23: 'Décision_IA_proposée',
    24: 'Commentaire_IA',
    25: 'Règle_correction_proposée',
    26: 'Analyse_IA'
  };
  var changed = false;

  Object.keys(expectedHeaders).forEach(function(columnText) {
    var column = Number(columnText);
    if (!hasValue_(headers[column - 1])) {
      headers[column - 1] = expectedHeaders[column];
      changed = true;
    }
  });

  if (changed) {
    sheet.getRange(1, 1, 1, COMPTA_ADMIN_ACTIONS_MAX_COLS).setValues([headers]);
  }
}

function ensureSheetSizeForFastView_(sheet, minRows, minColumns) {
  if (sheet.getMaxRows() < minRows) {
    sheet.insertRowsAfter(sheet.getMaxRows(), minRows - sheet.getMaxRows());
  }

  if (sheet.getMaxColumns() < minColumns) {
    sheet.insertColumnsAfter(sheet.getMaxColumns(), minColumns - sheet.getMaxColumns());
  }
}

function removeExistingFilter_(sheet) {
  var filter = sheet.getFilter();
  if (filter) {
    filter.remove();
  }
}

function buildHeaderIndex_(headerRow) {
  var index = {};
  for (var i = 0; i < headerRow.length; i++) {
    var key = normalizeHeaderForComptaAdmin_(headerRow[i]);
    if (key) {
      index[key] = i;
    }
  }
  return index;
}

function getByHeader_(row, headerIndex, headerName) {
  var key = normalizeHeaderForComptaAdmin_(headerName);
  if (!headerIndex.hasOwnProperty(key)) {
    return '';
  }
  return row[headerIndex[key]];
}

function normalizeHeaderForComptaAdmin_(value) {
  return normalizeTextForComptaAdmin_(value).replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '');
}

function normalizeTextForComptaAdmin_(value) {
  if (value === null || value === undefined) {
    return '';
  }

  return String(value)
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
}

function hasValue_(value) {
  return value !== null && value !== undefined && String(value).trim() !== '';
}
function appliquerColonnesVisiblesActions_(sheet) {
  const maxCols = sheet.getMaxColumns();

  // Sécurité : on réaffiche tout avant de masquer proprement.
  sheet.showColumns(1, maxCols);

  // Colonnes visibles dans 02_Actions :
  // E Domaine
  // H Action
  // I Priorité
  // L Statut_action
  // M Lien_Gmail
  // S Commentaire
  // T Dernière_maj
  // W Décision_IA_proposée
  // X Commentaire_IA
  // Y Règle_correction_proposée
  // Z Analyse_IA
  const visibles = {
    5: true,
    8: true,
    9: true,
    12: true,
    13: true,
    19: true,
    20: true,
    23: true,
    24: true,
    25: true,
    26: true
  };

  if (maxCols < 26) {
    Logger.log('Masquage annulé : 02_Actions a moins de 26 colonnes.');
    return;
  }

  for (let col = 1; col <= maxCols; col++) {
    if (!visibles[col]) {
      sheet.hideColumns(col);
    }
  }

  Logger.log('Colonnes visibles appliquées dans 02_Actions.');
}

function recreerFiltreActions_(sheet) {
  const maxCols = sheet.getMaxColumns();
  const lastRow = Math.min(Math.max(sheet.getLastRow(), 1), 300);

  const existingFilter = sheet.getFilter();
  if (existingFilter) {
    existingFilter.remove();
  }

  if (maxCols >= 26 && lastRow >= 1) {
    sheet.getRange(1, 1, lastRow, 26).createFilter();
    Logger.log('Filtre recréé sur 02_Actions A1:Z' + lastRow);
  }
}
